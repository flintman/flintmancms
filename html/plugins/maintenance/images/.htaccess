# Prevent directory listing
Options -Indexes

# Allow only image files to be accessed
<FilesMatch "\.(jpg|jpeg|png|gif)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

# Deny access to everything else
<FilesMatch "^(?!.*\.(jpg|jpeg|png|gif)$)">
    Order Allow,Deny
    Deny from all
</FilesMatch>
