# FlintmanCMS Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# Port used to connect to
APACHE_PORT=3000

# Security Configuration
# Enable HSTS (HTTP Strict Transport Security) - ONLY set to true when using HTTPS/SSL
ENABLE_HSTS=false

# Session Security Configuration (in seconds)
# Maximum session lifetime - sessions older than this are destroyed (default: 86400 = 24 hours)
SESSION_MAX_LIFETIME=86400
# Inactivity timeout - sessions idle longer than this are destroyed (default: 7200 = 2 hours)
SESSION_INACTIVITY_TIMEOUT=7200
# Session refresh interval - regenerate session ID periodically (default: 3600 = 1 hour)
SESSION_REFRESH_INTERVAL=3600

# Database Migration Security Key
# Used to protect web access to migrate.php - generate with: openssl rand -hex 32
MIGRATION_KEY=CHANGE_ME_TO_RANDOM_64_CHAR_HEX_STRING

# MySQL Root Password (for docker-compose)
MYSQL_ROOT_PASSWORD=CHANGE_ME_TO_STRONG_ROOT_PASSWORD
MYSQL_DATABASE=flintmancms
MYSQL_USER=flintmancms
MYSQL_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
MYSQL_HOST=db

# Security Notes:
# - Use strong random passwords (minimum 20 characters)
# - Use different passwords for DB_PASS and MYSQL_ROOT_PASSWORD
# - Generate passwords with: openssl rand -base64 32
# - Never commit .env file to git
# - Restrict .env file permissions: chmod 600 .env

